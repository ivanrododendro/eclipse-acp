<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.ui.views">
    <category
          id="dev.eclipseacp.client.views.category"
          name="ACP"/>
    <view
          allowMultiple="false"
          category="dev.eclipseacp.client.views.category"
          class="dev.eclipseacp.client.ui.AcpChatView"
          icon="icons/acp-chat.png"
          id="dev.eclipseacp.client.views.chat"
          name="Chat"
          restorable="true"/>
  </extension>

  <extension point="org.eclipse.ui.preferencePages">
    <page
          class="dev.eclipseacp.client.preferences.AcpPreferencePage"
          id="dev.eclipseacp.client.preferences"
          name="ACP"/>
  </extension>

  <extension point="org.eclipse.ui.commands">
    <category
          id="dev.eclipseacp.client.commands.category"
          name="ACP"/>
    <command
          categoryId="dev.eclipseacp.client.commands.category"
          id="dev.eclipseacp.client.commands.openChat"
          name="Open ACP Session">
      <commandParameter
            id="dev.eclipseacp.client.commands.openChat.action"
            name="Action"
            optional="true"/>
    </command>
    <!-- These actions are listed as upcoming functionality.  Intentionally omit
         handlers so Eclipse renders them disabled. -->
    <command
          categoryId="dev.eclipseacp.client.commands.category"
          id="dev.eclipseacp.client.commands.explainSelection"
          name="Explain selection"/>
    <command
          categoryId="dev.eclipseacp.client.commands.category"
          id="dev.eclipseacp.client.commands.fixProblems"
          name="Fix problems"/>
    <command
          categoryId="dev.eclipseacp.client.commands.category"
          id="dev.eclipseacp.client.commands.refactorSelection"
          name="Refactor selection"/>
    <command
          categoryId="dev.eclipseacp.client.commands.category"
          id="dev.eclipseacp.client.commands.testSelection"
          name="Test selection"/>
  </extension>

  <extension point="org.eclipse.ui.handlers">
    <handler
          class="dev.eclipseacp.client.ui.OpenAcpChatHandler"
          commandId="dev.eclipseacp.client.commands.openChat"/>
  </extension>

  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
      <menu id="dev.eclipseacp.client.menus.acp" label="ACP">
        <command commandId="dev.eclipseacp.client.commands.openChat" label="Open ACP Session" style="push">
          <visibleWhen checkEnabled="false">
            <with variable="selection">
              <iterate ifEmpty="false">
                <adapt type="org.eclipse.core.resources.IResource"/>
              </iterate>
            </with>
          </visibleWhen>
        </command>
        <command commandId="dev.eclipseacp.client.commands.explainSelection" label="Explain selection" style="push"/>
        <command commandId="dev.eclipseacp.client.commands.fixProblems" label="Fix problems" style="push"/>
        <command commandId="dev.eclipseacp.client.commands.refactorSelection" label="Refactor selection" style="push"/>
        <command commandId="dev.eclipseacp.client.commands.testSelection" label="Test selection" style="push"/>
      </menu>
    </menuContribution>
  </extension>

  <extension point="org.eclipse.ui.bindings">
    <key
          commandId="dev.eclipseacp.client.commands.openChat"
          contextId="org.eclipse.ui.contexts.window"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+O"/>
  </extension>

  <extension point="org.eclipse.core.runtime.preferences">
    <initializer class="dev.eclipseacp.client.preferences.AcpPreferenceInitializer"/>
  </extension>
</plugin>
